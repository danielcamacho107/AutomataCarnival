VisualElement {
}

.menu-text {
    -unity-text-align: middle-center;
    font-size: 450%;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
}

.menu-credits-text {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 1px 100px;
}

.menu-button {
    height: 25%;
    width: 25%;
    margin-top: 1%;
    margin-bottom: 1%;
    margin-right: 0%;
    margin-left: 0%;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
}

.menu-credits-button {
    flex-grow: 1;
    aspect-ratio: 1;
}

.menu-button-container {
    padding-top: 1%;
    padding-right: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    flex-grow: 1;
    flex-wrap: wrap;
    align-content: center;
    align-items: flex-start;
    flex-direction: column;
    justify-content: space-between;
    align-self: stretch;
}

.menu-credits-container {
    padding-top: 1%;
    padding-right: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    flex-grow: 1;
    flex-wrap: wrap;
    align-content: center;
    align-items: flex-start;
    flex-direction: column;
    justify-content: space-between;
    align-self: stretch;
    flex-basis: 60%;
    flex-shrink: 0;
    left: -5%;
    width: 110%;
}

.menu-credits-collaborator-container {
    flex-direction: row;
    width: 33%;
    height: 50%;
    padding-right: 2%;
    padding-left: 2%;
}

.menu-credits-collaborator-label-container {
    width: 80%;
    height: 100%;
    justify-content: space-evenly;
    padding-right: 5%;
}

.menu-credits-collaborator-link-container {
    width: 20%;
    aspect-ratio: 1;
    align-self: center;
    align-items: center;
}

.hud-text {
    -unity-text-align: middle-center;
    font-size: 450%;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
}

.hud-container {
    flex-grow: 1;
    flex-direction: row;
}

.hud-text-container {
    background-color: rgba(0, 0, 0, 0.5);
}
