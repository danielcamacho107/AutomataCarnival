        <ui:Button text="Back" name="BackToMenuButton" class="menu-button menu-text menu-credits-text" style="aspect-ratio: 1.5; height: 10%; bottom: 5%; left: -5%;"/>
    </ui:VisualElement>
</ui:UXML>
