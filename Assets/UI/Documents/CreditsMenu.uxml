<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Screen%20Menu.uss?fileID=7433441132597879392&amp;guid=b2bc59ce1b0d0ef46a357fd9a158d72f&amp;type=3#Screen Menu"/>
    <ui:VisualElement name="" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.75); padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; background-image: url(&quot;project://database/Assets/GUIPackCartoon/Sources/Backgrounds/Home%20Scene/Home%20Scene%20-%20Background.psd?fileID=2800000&amp;guid=5a4f8fd15a8d04ce982def866de0670c&amp;type=3#Home Scene - Background&quot;);">
        <ui:Label text="Automata Carnival" name="Title" class="menu-text" style="font-size: 140%; flex-basis: 40%;"/>
        <ui:VisualElement name="CreditsContainer" class="menu-credits-container">
            <ui:VisualElement name="CollaboratorContainer" class="menu-credits-collaborator-container">
                <ui:VisualElement name="LabelContainer" class="menu-credits-collaborator-label-container">
                    <ui:Label text="Name" name="Name" class="menu-text menu-credits-text"/>
                    <ui:Label text="Attribution" name="Attribution" class="menu-text menu-credits-text"/>
